{
  "manifest_version": 3,
  "name": "Shopee Purchase & Spending Tracker",
  "version": "1.0.0",
  "description": "Fetch, analyze, and visualize all-time purchase history and spending on Shopee MY.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee Purchase Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.com.my/*",
        "https://*.shopee.com.my/*"
      ],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.com.my/*",
        "https://*.shopee.com.my/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://shopee.com.my/*",
    "https://*.shopee.com.my/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "assets/*"
      ],
      "matches": ["https://shopee.com.my/*", "https://*.shopee.com.my/*"]
    }
  ]
}
